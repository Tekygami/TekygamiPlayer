<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Asset\Ava.ico" />
    <None Remove="Asset\Background1.png" />
    <None Remove="Asset\Cat_HeadBang.gif" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Asset\Ava.ico" />
    <Resource Include="Asset\Background1.png" />
    <Resource Include="Asset\Cat_HeadBang.gif" />
  </ItemGroup>

</Project>
