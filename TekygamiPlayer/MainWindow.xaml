<Window x:Class="TekygamiPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:TekygamiPlayer"
        mc:Ignorable="d"
        Title="TekygamiPlayer" Width="1024" Height="768" 
        Icon="pack://application:,,,/TekygamiPlayer;component/Asset/Ava.ico">


    <Window.Background>
        <ImageBrush ImageSource="/Asset/Background1.png" Stretch="UniformToFill"/>
    </Window.Background>

    <!-- Стили для всех кнопок -->

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#9c80f7"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnSelectFolder" Grid.Row="0" Grid.Column="0" Content="Select Music Folder" Height="30" Width="200" Margin="0" HorizontalAlignment="Left" Click="BtnSelectFolder_Click"/>
            <Slider x:Name="VolumeSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" HorizontalAlignment="Right" Margin="0" Width="100" ValueChanged="VolumeSlider_ValueChanged"/>

            
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="AlbumArtImage" Grid.Column="1" Margin="10" Stretch="Uniform"/>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>



                <ListBox x:Name="LbPlayList" Grid.Row="0"  Margin="5" Foreground="Black">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

                <Image x:Name="CatGifImage" Grid.Row="1" Width="200" Height="200" Margin="5" HorizontalAlignment="Center" Stretch="Uniform" gif:ImageBehavior.AnimatedSource="/Asset/Cat_HeadBang.gif" gif:ImageBehavior.AutoStart="False"/>

            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnPlay" Content="Play" Width="75" Height="30"  Margin="5"/>
            <Button x:Name="BtnPause" Content="Pause" Width="75" Height="30" Margin="5"/>
            <Button x:Name="BtnStop" Content="Stop" Width="75" Height="30" Margin="5"/>
            <Button x:Name="BtnNext" Content="Next" Width="75" Height="30" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
